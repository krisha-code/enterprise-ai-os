# Local development defaults only. Replace JWT_SECRET_KEY before using real data.
APP_NAME=Enterprise AI OS
APP_VERSION=1.0.0
DEBUG=false

# These values must match the db service in docker-compose.yml.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=enterprise_ai_os
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Generate a private key for your local .env; never commit that real key.
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-starting

# Ollama runs on the host machine and is reached from the backend container.
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
